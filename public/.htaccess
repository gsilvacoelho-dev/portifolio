# ---------------------------------------------------------------------------
# Hostinger (Apache / LiteSpeed) — site estático
# Este arquivo é copiado para dentro de /dist no build e deve subir junto
# com o restante do conteúdo para public_html.
# ---------------------------------------------------------------------------

# --- HTTPS e domínio canônico -----------------------------------------------
# Descomente DEPOIS de ativar o SSL no painel da Hostinger.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
#
#   # força a versão sem www (ou inverta, se preferir com www)
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
# </IfModule>

# --- Compressão -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache ------------------------------------------------------------------
# Os assets do Vite têm hash no nome, então podem ser cacheados para sempre.
# O index.html NUNCA pode ser cacheado, senão o deploy novo não aparece.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType application/pdf         "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Segurança ---
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Tipos MIME -------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Página de erro ---------------------------------------------------------
# O site é uma página única: qualquer caminho desconhecido volta para a raiz.
ErrorDocument 404 /index.html
